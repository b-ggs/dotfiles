default:
  just -g --list

drive_share_to_download_link share_link:
  #!/usr/bin/env python3

  import sys

  share_link = "{{share_link}}"

  print("Share link:", share_link, file=sys.stderr)

  if not share_link.startswith("https://drive.google.com/file/d/"):
      print("Invalid share link.", file=sys.stderr)
      sys.exit(1)
  file_id = share_link.split("/")[5]
  download_link = f"https://drive.google.com/uc?id={file_id}&export=download"

  print(download_link, end="")

get_deepl_link lang *args:
  #!/usr/bin/env python3

  import sys
  import urllib.parse

  language = "{{lang}}"
  text = "{{args}}"

  print(f"Language: {language}", file=sys.stderr)
  print(f"Text: {text}", file=sys.stderr)

  url = "https://www.deepl.com/en/translator#"
  url += f"{language}/en/"
  url += urllib.parse.quote(text)

  if not sys.stdout.isatty():
      print(f"Piping URL to stdout: {url}", file=sys.stderr)

  print(url, end="")

test_darwin:
  test "$(uname)" == "Darwin"

reset_dock: test_darwin
  defaults write com.apple.dock tilesize -int 32
  killall Dock

show_desktop: test_darwin
  defaults write com.apple.finder CreateDesktop true
  killall Finder

hide_desktop: test_darwin
  defaults write com.apple.finder CreateDesktop false
  killall Finder

charger_watts: test_darwin
  ioreg -r -c AppleSmartBattery | grep -i "AppleRawAdapterDetails" | sed "s/.*\"Watts\"=\([0-9]*\).*/\1/" | xargs echo -n

flush_dns_cache: test_darwin
  sudo dscacheutil -flushcache
  sudo killall -HUP mDNSResponder

set_hostname hostname: test_darwin
  sudo scutil --set ComputerName "{{hostname}}"
  sudo scutil --set LocalHostName "{{hostname}}"
  sudo scutil --set HostName "{{hostname}}"

lock: test_darwin
  open -a ScreenSaverEngine

thermals: test_darwin
  sudo powermetrics -s thermal

keychain:
  keychain --nogui -q $HOME/.ssh/id_ed25519

ipify:
  curl -s https://api.ipify.org

utcnow:
  date -u +"%Y-%m-%dT%H:%M:%SZ" | xargs echo -n

utcnowsafe:
  date -u +"%Y-%m-%dT%H%M%SZ" | xargs echo -n

remove_dot_underscore_files_recursively:
  find . -name "._*" -type f -delete

set_helium_user_color2: test_darwin
  #!/usr/bin/env python3

  import json
  import glob
  import os

  pattern = os.path.expanduser("~/Library/Application Support/net.imput.helium/*/Preferences")
  for path in glob.glob(pattern):
      with open(path) as f:
          prefs = json.load(f)
      prefs.setdefault("browser", {}).setdefault("theme", {})["user_color2"] = -733719
      with open(path, "w") as f:
          json.dump(prefs, f, separators=(",", ":"))
      print(f"Updated: {path}")

wifi_password ssid="": test_darwin
  #!/usr/bin/env bash
  set -euo pipefail

  name="{{ssid}}"
  if [ -z "$name" ]; then
    name="$(networksetup -getairportnetwork en0 2>/dev/null | awk -F': ' '{print $2}')"
  fi

  if [ -z "$name" ]; then
    echo "No SSID provided and could not determine the current network." >&2
    exit 1
  fi

  security find-generic-password -s "AirPort" -a "$name" -w

[no-cd]
[positional-arguments]
strip_exif +files:
  uv run --with piexif python -c 'import sys; import piexif; files = sys.argv[1:]; [piexif.remove(path) for path in files]; remaining = [path for path in files if any(piexif.load(path).values())]; sys.exit(f"EXIF remains in: {remaining}" if remaining else 0)' "$@"
