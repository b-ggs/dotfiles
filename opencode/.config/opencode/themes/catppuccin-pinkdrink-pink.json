{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "macAccent": "#f5c2e7",
    "macPrimary": "#efadec",
    "macRosewater": "#f5e0dc",
    "macFlamingo": "#f2cdcd",
    "macPink": "#f5c2e7",
    "macMauve": "#cba6f7",
    "macRed": "#f38ba8",
    "macMaroon": "#eba0ac",
    "macPeach": "#fab387",
    "macYellow": "#f9e2af",
    "macGreen": "#a6e3a1",
    "macTeal": "#94e2d5",
    "macSky": "#89dceb",
    "macSapphire": "#74c7ec",
    "macBlue": "#89b4fa",
    "macLavender": "#b4befe",
    "macText": "#f4cde9",
    "macSubtext1": "#debad4",
    "macSubtext0": "#c8a6be",
    "macOverlay2": "#b293a8",
    "macOverlay1": "#9c7f92",
    "macOverlay0": "#866c7d",
    "macSurface2": "#705867",
    "macSurface1": "#5a4551",
    "macSurface0": "#44313b",
    "macBase": "#352939",
    "macMantle": "#211924",
    "macCrust": "#1a1016",
    "macHighlight": "#473747"
